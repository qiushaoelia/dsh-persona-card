{
  "name": "dsh-persona-card",
  "version": "0.1.0",
  "description": "人格卡：在设置里切换 / 编辑人格卡，实时改变 agent 的系统提示人格层。",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "sync": "node sync.mjs",
    "sync:restart": "node sync.mjs --restart",
    "sync:list": "node sync.mjs --list",
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "persona",
    "system-prompt"
  ],
  "license": "MIT",
  "author": "qiushaoelia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiushaoelia/dsh-persona-card.git"
  },
  "bugs": {
    "url": "https://github.com/qiushaoelia/dsh-persona-card/issues"
  },
  "homepage": "https://github.com/qiushaoelia/dsh-persona-card#readme",
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ]
}
